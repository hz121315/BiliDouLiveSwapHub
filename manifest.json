{
  "manifest_version": 3,
  "name": "BiliDouLiveSwapHub",
  "short_name": "BiliDouLive",
  "version": "1.4.1",
  "description": "把哔哩哔哩直播间的视频画面替换为抖音直播间，保留B站弹幕、聊天和播放器功能；支持调节延迟与快进以对齐弹幕。",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://live.douyin.com/*",
    "https://v.douyin.com/*",
    "https://*.douyin.com/*",
    "https://douyin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BiliDouLiveSwapHub（点击展开/收起面板）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://live.bilibili.com/*"
      ],
      "js": [
        "vendor/flv.min.js",
        "vendor/hls.min.js",
        "vendor/mpegts.js",
        "src/content.js"
      ],
      "css": [
        "src/panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
